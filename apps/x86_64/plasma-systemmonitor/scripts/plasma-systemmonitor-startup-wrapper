#!/usr/bin/env bash

# SPDX-License-Identifier: BSD-3-Clause
# Copyright 2026 <Nitrux Latinoamericana S.C. <hello@nxos.org>>


# -- Exit on errors.

set -eu


# -- Get the running directory of the AppImage.

REALPATH=$(readlink -f "$0")
APPDIR=$(dirname "$(dirname "$(dirname "$REALPATH")"))")

export PATH="$APPDIR/usr/lib/x86_64-linux-gnu/libexec/ksysguard:$PATH"


# -- Ensure the require daemons are running.

"$APPDIR/usr/bin/ksystemstats" &
KSYSTEMSTATS_PID=$!
sleep 1

trap 'kill "$KSYSTEMSTATS_PID" 2>/dev/null || true; wait "$KSYSTEMSTATS_PID" 2>/dev/null || true' EXIT
trap 'exit 143' INT TERM HUP


# -- Run the application.

set +e
"$APPDIR/usr/bin/plasma-systemmonitor" "$@"
STATUS=$?
set -e

exit "$STATUS"
